flowchart TD
    %% ============================================================
    %% ERP 采购到付款（P2P）流程 - 部门泳道图（策略②）
    %% 泳道 = 部门：采购部 | 供应商 | 仓储质检部 | 财务部
    %% 道内节点标注岗位（如"采购员"），跨泳道箭头 = 部门间单据流转
    %% ============================================================

    %% ---------- 样式 ----------
    classDef proc  fill:#ddf4ff,stroke:#0969da,color:#0a3069,stroke-width:1.5px;
    classDef dec   fill:#fff8c5,stroke:#9a6700,color:#633c01,stroke-width:1.5px;
    classDef data  fill:#dafbe1,stroke:#1a7f37,color:#0a3d1e,stroke-width:1.5px;

    %% ================= 泳道 1：采购部 =================
    subgraph LANE_PUR["采购部 Purchasing"]
        direction LR
        P0([开始：产生采购需求])
        P1[采购员：提交采购申请 PR]:::proc
        P2{采购经理：审批通过?}:::dec
        P3[采购员：下达采购订单 PO]:::proc
        P4[采购员：提交收货单与订单]:::proc
        P0 --> P1
        P1 --> P2
        P2 -->|通过| P3
        P2 -->|驳回| P1
    end

    %% ================= 泳道 2：供应商 =================
    subgraph LANE_SUP["供应商 Supplier"]
        direction LR
        S1[供应商：备货并发货]:::proc
        S2[供应商：开具发票]:::proc
        S3[供应商：收款并确认]:::proc
    end

    %% ================= 泳道 3：仓储质检部 =================
    subgraph LANE_WH["仓储质检部 Warehouse & QC"]
        direction LR
        W1[仓库：到货收货]:::proc
        W2[质检：来料检验]:::proc
        W3{质检：检验合格?}:::dec
        W4[仓库：入库并更新库存]:::proc
        W1 --> W2
        W2 --> W3
        W3 -->|合格| W4
    end

    %% ================= 泳道 4：财务部 =================
    subgraph LANE_FIN["财务部 Finance"]
        direction LR
        F1[应付会计：三单匹配<br/>PO / 入库单 / 发票]:::proc
        F2{匹配通过?}:::dec
        F3[应付会计：登记应付账款]:::proc
        F4[出纳：银行付款]:::proc
        F5[应付会计：账务核销]:::proc
        F1 --> F2
        F2 -->|通过| F3
        F2 -->|不通过| F1
        F3 --> F4
        F4 --> F5
        F5 --> F6([结束：付款完成])
    end

    %% ================= 跨泳道：单据流转 =================
    P3 -->|下达 PO| S1
    S1 -->|送货| W1
    W3 -->|不合格 · 退货| S1
    W4 -->|入库完成| P4
    P4 -->|提交收货单| F1
    S2 -->|发票| F1
    F4 -->|付款| S3
    S3 -->|收款确认| F5
